# Copy to .env for local docker compose defaults. Not used in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoicing
POSTGRES_PORT=5432

# Dev-only JWT signing config for the api container. Override locally if you want tokens
# minted by `make up` to differ from the checked-in defaults; never reuse these in production.
JWT_SIGNING_KEY=docker-compose-dev-only-signing-key-32b-min
JWT_ISSUER=InvoicingApi.Docker
JWT_AUDIENCE=InvoicingApi.Docker
